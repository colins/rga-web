<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Prevent SiteGround Dynamic Cache and browsers from caching index.html and SPA routes
  Header set Cache-Control "private, no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"

  # Allow hashed static assets (which have content hashes in their filename) to be cached
  <FilesMatch "\.(js|css|webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
